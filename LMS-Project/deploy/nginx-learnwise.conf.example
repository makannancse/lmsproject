# Example Nginx config when document root is the Laravel-style public/ folder.
# Point root to .../LMS-Project/public and route all requests to index.php.

server {
    listen 443 ssl http2;
    server_name www.edulearnwise.com edulearnwise.com;

    root /var/www/edulearnwise/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Do not serve a physical /admin directory — all /admin/* must hit index.php.
}
