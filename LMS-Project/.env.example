APP_ENV=local
# Single source of truth for all application URLs (must include http:// or https://).
APP_URL=http://localhost/lmsproject/LMS-Project/public
# Optional override only if APP_URL path detection fails.
APP_BASE_PATH=

APP_NAME=LMS
APP_TIMEZONE=UTC
TOKEN_ENCRYPTION_KEY=generate_a_random_64_char_hex_key

# --- Google Calendar / Google Meet ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional override; default is derived from APP_URL + /auth/google/callback
# GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CAINFO=certs/cacert.pem
STATIC_MEETING_LINK=
GOOGLE_REQUIRE_WORKSPACE_DOMAIN=0
GOOGLE_WORKSPACE_DOMAIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_db
DB_USERNAME=root
DB_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_app_password
SMTP_ENCRYPTION=tls
SMTP_FROM=you@example.com
SMTP_FROM_NAME=LMS Admin

ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_HOST_EMAIL=teacher-zoom-account@example.com
ZOOM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_token
ZOOM_REDIRECT_URI=

STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_PUBLIC_KEY=your_stripe_public
STRIPE_DEFAULT_CURRENCY=USD
