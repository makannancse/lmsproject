APP_ENV=local
APP_URL=http://localhost/LMS-Project/public
APP_NAME=LMS
APP_TIMEZONE=UTC
TOKEN_ENCRYPTION_KEY=generate_a_random_64_char_hex_key

# --- Google Calendar / Google Meet ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/LMS-Project/public/auth/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CAINFO=certs/cacert.pem
STATIC_MEETING_LINK=
# Optional: require Google sign-ins to match a specific Workspace domain (default: off; personal Gmail allowed).
GOOGLE_REQUIRE_WORKSPACE_DOMAIN=0
# Optional: enforced domain when GOOGLE_REQUIRE_WORKSPACE_DOMAIN=1 (e.g. school.edu).
GOOGLE_WORKSPACE_DOMAIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_db
DB_USERNAME=root
DB_PASSWORD=

# --- SMTP (read from $_ENV by Mailer after dotenv loads in app/config/config.php) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_app_password
SMTP_ENCRYPTION=tls
# Optional; "From" is set in code to SMTP_USERNAME + "LMS Admin" for Gmail compatibility.
SMTP_FROM=you@example.com
SMTP_FROM_NAME=LMS Admin
# Gmail: use an App Password (Google Account → Security → 2-Step → App passwords), NOT your normal password.
# Example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_ENCRYPTION=tls

# --- Zoom Server-to-Server OAuth (create meetings; no browser redirect) ---
# In Zoom Marketplace → your S2S app → Scopes, enable at least meeting:write:admin (or user meeting write for that user).
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
# Licensed Zoom user on this account who will own scheduled meetings (email works as API userId).
# Note: POST .../users/me/meetings only works with user-level OAuth; S2S uses /users/{ZOOM_HOST_EMAIL}/meetings.
ZOOM_HOST_EMAIL=teacher-zoom-account@example.com
# WAMP/XAMPP SSL: if cURL says "unable to get local issuer certificate", download
# https://curl.se/ca/cacert.pem into e.g. certs/cacert.pem and set:
# ZOOM_CAINFO=certs/cacert.pem
# Or in php.ini: curl.cainfo="C:\path\to\cacert.pem" and openssl.cafile= same path.
# Local dev only (insecure): ZOOM_SSL_VERIFY=0

# Optional override; default https://api.zoom.us/v2
# ZOOM_API_BASE=https://api.zoom.us/v2
# Optional: timezone label used only by test_zoom.php
# ZOOM_TEST_TIMEZONE=Asia/Kolkata

# --- Zoom webhooks (zoom_webhook.php at project root; use HTTPS + ngrok locally) ---
# Enable Cloud Recording in the Zoom account and subscribe to recording.completed for real play_url values.
# Secret Token from Zoom app → Feature → Event Subscriptions. Required to verify x-zm-signature.
ZOOM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_token
# Local Postman only — never enable in production:
# ZOOM_WEBHOOK_SKIP_SIGNATURE=1

# User OAuth (different flow; only if you add a browser Zoom login feature)
ZOOM_REDIRECT_URI=http://localhost/LMS-Project/public/zoom/callback

STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_PUBLIC_KEY=your_stripe_public
STRIPE_DEFAULT_CURRENCY=USD
